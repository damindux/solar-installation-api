# Direct PostgreSQL connection used by migrations and, by default, the app.
DATABASE_URL=postgresql://user:password@localhost:5432/solar_generation
# Optional pooled URL for runtime queries.
# DATABASE_URL_POOLED=
# Generate with: openssl rand -base64 32. Never commit the real value.
JWT_SECRET=change-me
# Optional port from 1 to 65535. Defaults to 8000.
PORT=8000
# Optional password for seeded demo users.
# SEED_DEMO_PASSWORD=
# Optional throw-away database URL for integration tests.
# TEST_DATABASE_URL=
