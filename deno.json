{
  "fmt": {
    "exclude": [".agents/**", "references/**", "seed.json"]
  },
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --env-file --watch main.ts",
    "start": "deno run --allow-env --allow-net --allow-read main.ts",
    "test": "deno test --allow-env --allow-read --allow-net",
    "check": "deno fmt --check && deno lint && deno check main.ts scripts/seed.ts",
    "db:generate": "deno run -A --env-file npm:drizzle-kit generate",
    "db:migrate": "deno run -A --env-file npm:drizzle-kit migrate",
    "db:seed": "deno run --allow-env --allow-net --allow-read --allow-write=scripts/.out --env-file scripts/seed.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14",
    "drizzle-orm": "npm:drizzle-orm@0.44.7",
    "drizzle-orm/": "npm:/drizzle-orm@0.44.7/",
    "drizzle-kit": "npm:drizzle-kit@0.31.4",
    "postgres": "npm:postgres@3.4.7",
    "bcryptjs": "npm:bcryptjs@2.4.3"
  }
}
