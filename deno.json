{
  "fmt": {
    "exclude": [".agents/**", "references/**", "seed.json"]
  },
  "tasks": {
    "dev": "deno run --allow-env --allow-net --allow-read --env-file --watch main.ts",
    "start": "deno run --allow-env --allow-net --allow-read main.ts",
    "test": "deno test --allow-env --allow-read --allow-net",
    "check": "deno fmt --check && deno lint && deno check main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1"
  }
}
